# ===== Logs =====
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===== Dependencies & build output =====
node_modules
dist
dist-ssr
dist-electron
dist-electron-v2
dist-electron-v3
release
*.local

# ===== Environment & secrets =====
# لا تُرفع أي مفاتيح أو كلمات مرور إلى Git
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example

# ===== Databases & backups (بيانات عملاء حقيقية) =====
server/*.db
server/*.db-*
server/*.sqlite
server/*.sqlite-*
server/backups/
server/*.log

# ===== مفاتيح الترخيص الخاصة (لا تُرفع أبداً) =====
tools/keys/
*.pem
!tools/keys/.gitkeep

# ===== Python =====
__pycache__/
*.py[cod]
.pytest_cache/
server/build/
server/dist/
electron/resources/procashier-server.exe

# ===== Editor directories and files =====
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
*.tmp
TEMP*.pdf

# ===== Flutter (flutter_app لديه .gitignore خاص به) =====
flutter_app/build/
flutter_app/.dart_tool/
