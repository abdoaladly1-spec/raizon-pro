{
  "name": "procashier-system",
  "version": "1.0.0",
  "description": "RaiZon Pro v1 — منصة إدارة متكاملة للمحترفين",
  "author": "Eng. Abdelrahman Fathy El-Adly",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server:build": "node tools/build-server.mjs",
    "license:make": "node tools/make-license.mjs",
    "electron:build": "npm run build && npm run server:build && electron-builder"
  },
  "build": {
    "appId": "com.raizon.pro",
    "productName": "RaiZon Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "server/**/*",
      "!server/*.db",
      "!server/*.db-*",
      "!server/.env",
      "!server/__pycache__/**",
      "!server/backups/**",
      "!server/*.log",
      "!server/smoke_test.py",
      "!server/electron_sync_test.ts"
    ],
    "asar": true,
    "asarUnpack": [
      "server/**"
    ],
    "extraResources": [
      {
        "from": "electron/resources",
        "to": ".",
        "filter": [
          "procashier-server.exe"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    }
  },
  "dependencies": {
    "astral-regex": "^2.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.6",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
