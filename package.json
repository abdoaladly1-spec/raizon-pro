{
  "name": "procashier-system",
  "version": "1.0.1",
  "description": "RaiZon Pro v1 — منصة إدارة متكاملة للمحترفين",
  "author": "Eng. Abdelrahman Fathy El-Adly",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server:build": "node tools/build-server.mjs",
    "license:make": "node tools/make-license.mjs",
    "installer:build": "powershell -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "electron:build": "npm run build && npm run server:build && electron-builder && npm run installer:build"
  },
  "build": {
    "appId": "com.raizon.pro",
    "productName": "RaiZon Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/resources/**",
      "public/**/*"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "electron/resources",
        "to": ".",
        "filter": [
          "procashier-server.exe"
        ]
      }
    ],
    "extraFiles": [
      {
        "from": "electron/resources",
        "to": ".",
        "filter": [
          "Patcher.exe"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "dolaa2",
        "repo": "raizon-pro"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "RaiZon Pro",
      "runAfterFinish": false,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false
    }
  },
  "dependencies": {
    "@material/web": "^2.5.0",
    "@supabase/supabase-js": "^2.119.0",
    "astral-regex": "^2.0.0",
    "electron-updater": "^6.8.11",
    "jspdf": "^4.2.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.6",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
