# ===== إعدادات سيرفر ProCashier =====
# انسخ هذا الملف إلى .env واملأ القيم

SERVER_HOST=0.0.0.0
SERVER_PORT=8087
DB_PATH=C:/procashier/procashier.db

# مفتاح API (اختياري) - لو اتحط لازم العملاء يبعتوا Header: X-API-Key
API_KEY=

# ===== Gmail SMTP =====
# استخدم App Password (16 خانة) من حساب Google -> Security -> 2-Step Verification -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourapp@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
EMAIL_TO=owner@example.com
EMAIL_FROM=yourapp@gmail.com
EMAIL_SUBJECT_PREFIX=[ProCashier]

# auto => إرسال حقيقي لو Gmail متعملة، غير كده محاكاة
# simulation => تسجيل فقط بدون إرسال
# off => إيقاف الإيميلات
EMAIL_MODE=auto

# إرسال إشعار عند كل فاتورة جديدة
NOTIFY_ON_INVOICE=true

